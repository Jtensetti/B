{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "B",
  "scopeName": "source.bee",
  "patterns": [
    {"name": "string.quoted.double.bee", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.bee", "match": "\\\\(?:[\\\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"}]},
    {
      "match": "^([ \\t]*)(next)([ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]+)(when)\\b",
      "captures": {
        "2": {"name": "keyword.declaration.bee"},
        "4": {"name": "keyword.control.bee"}
      }
    },
    {"name": "keyword.declaration.bee", "match": "^\\s*also(?=[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]*\\()"},
    {"name": "keyword.control.bee", "match": "\\b(?:if|then|else|and|or|not|assert|count[ \\t]+(?:adjacent|earlier)|summarize(?=[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]+in\\b)|cases(?=[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]*\\{))\\b"},
    {"name": "keyword.declaration.bee", "match": "\\b(?:use|foreign|let|fn|as|print)\\b"},
    {"name": "support.type.bee", "match": "\\b(?:Int|Float|Bool|Text|Any|List|Option|Dict)\\b"},
    {"name": "constant.language.bee", "match": "\\b(?:true|false|none)\\b"},
    {"name": "constant.numeric.bee", "match": "\\b\\d+(?:\\.\\d+)?\\b"},
    {"name": "support.constant.bee", "match": "\\b(?:py|net)(?=:)"},
    {"name": "keyword.operator.bee", "match": "(?:=>|->|\\?\\?|==|!=|<=|>=|[+\\-*/%<>:=])"}
  ]
}
