{
  "name": "b-language-syntax",
  "displayName": "B Language Syntax",
  "description": "Basic highlighting for the experimental B language (.bsrc).",
  "version": "0.2.0",
  "publisher": "b-language",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "b-language",
      "aliases": ["B (experimental)", "B Source"],
      "extensions": [".bsrc"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "b-language",
      "scopeName": "source.bsrc",
      "path": "./syntaxes/b.tmLanguage.json"
    }]
  }
}
