# A collision resets velocity to +2 at tick 5; the old guarantee is retained here for inspection.
fn velocity(t: Int) -> Int pure requires t >= 0 ensures (t <= 3 or result < 0) and (t >= 3 or result > 0) and (t != 3 or result == 0) = if t < 5 then 3 - t else 7 - t
fn descent_speed(t: Int) -> Int pure requires t > 3 ensures result > 0 = -velocity(t)
fn time_per_unit(t: Int) -> Float pure requires t > 3 = 1 / descent_speed(t)
