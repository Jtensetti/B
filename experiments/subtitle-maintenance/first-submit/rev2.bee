fn classify(start: Int, end: Int, spoken_until: Int, effect_until: Int, words: Int, effect: Bool) -> Text pure = if end <= start then "bad-time" else if start < effect_until or (effect and start < spoken_until) or (not effect and spoken_until - start > 80 and end - start > 80) then "overlap" else if end - start < (if effect then 750 else if words == 1 or words == 2 then 550 else 1000) then "brief" else "ok"
