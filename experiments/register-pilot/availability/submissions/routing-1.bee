fn lane(code: Int) -> Int pure requires code >= -3 and code <= 35 = if code == -2 then 8 else if code < 0 then 9 else if code < 5 then 1 else if code == 5 then 4 else if code <= 10 then 2 else if code <= 15 then 7 else if code == 18 then 2 else if code <= 22 then 3 else if code <= 30 then 5 else if code == 31 then 7 else 6
fn tag(batch: Int) -> Int pure = 3 * batch + 1
