use py:json as json

record Booking { id: Text, child: Bool, day: Text, member: Bool }
record Input { bookings: List[Booking] }

foreign json.loads(Text) -> Input

fn free_entry(child: Bool, day: Text) -> Bool pure = child and (day == "sat" or day == "sun")

fn ticket(child: Bool, member: Bool, day: Text) -> Int pure = if free_entry(child, day) then 0 else if member then 90 else 100

fn fee(child: Bool, day: Text) -> Int pure = if free_entry(child, day) then 0 else 15

fn total(b: Booking) -> Int pure = ticket(b.child, b.member, b.day) + fee(b.child, b.day)

let data = json.loads(read_line())

print to_json({totals = {b.id: total(b) for b in data.bookings}})
