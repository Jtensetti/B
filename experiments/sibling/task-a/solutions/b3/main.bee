use go:"./libs/tariff" as tariff
use rust:"./libs/geo" as geo
use cs:"./libs/Tax" as tax
use py:json as json
use py:libs.calendar.workdays as cal
use js:"fastest-levenshtein" as words

record Depot { lat: Float, lon: Float }
record Item { weight: Float }
record Order { id: Text, product: Text, qty: Option[Int], express: Option[Bool], country: Text, lat: Float, lon: Float, date: Text, business: Bool }
record Input { depot: Depot, catalog: Dict[Text, Float], rates: Dict[Text, Float], orders: List[Order] }
record Quote { price: Float, delivery: Text, currency: Text }

foreign json.loads(Text) -> Input
foreign tariff.Zone(Text) -> Option[Int] on error
foreign tax.Vat.Rate(Text) -> Option[Float] on error

let data = json.loads(read_line())
let names = sorted(keys(data.catalog))
let blank = {price = 0.0, delivery = "", currency = "SEK"}

fn match_name(product: Text) -> Option[Text] =
    let near = if len(names) == 0 then "" else words.closest(product, names)
    if product in data.catalog then product
    else if len(names) > 0 and words.distance(product, near) <= 2 then near
    else none

fn in_eur(gross: Float, rate: Float) -> Float =
    if rate != 0.0 then round(gross / rate, 2) else round(gross, 2)

fn price_of(o: Order, name: Text, zone: Int) -> Quote =
    let weight = (o.qty ?? 1) * (data.catalog[name] ?? 0.0)
    let km = geo.road_km(data.depot.lat, data.depot.lon, o.lat, o.lon)
    let fast = o.express ?? false
    let base = if o.business and weight >= 50.0 then 0.0 else tariff.BasePrice(zone, weight)
    let surcharge = min(400.0, 0.8 * max(0.0, km - 300.0))
    let net = (if fast then base * 1.5 else base) + surcharge
    let rate = if tax.Vat.ReverseCharge(o.country, o.business) then 0.0 else (tax.Vat.Rate(o.country) ?? 0.0)
    let day = if fast and cal.is_workday(o.date) then o.date else cal.next_workday(o.date)
    let gross = net * (1.0 + rate)
    if o.country == "SE" then {price = round(gross, 2), delivery = day, currency = "SEK"} else {price = in_eur(gross, data.rates["EUR"] ?? 1.0), delivery = day, currency = "EUR"}

fn quote_of(o: Order) -> Option[Quote] =
    let name = match_name(o.product)
    let zone = tariff.Zone(o.country)
    if name == none or zone == none then none else price_of(o, name, zone)

let known = [o for o in data.orders where quote_of(o) != none]
let quotes = {o.id: quote_of(o) ?? blank for o in known}
let unknown = sorted([o.id for o in data.orders where quote_of(o) == none])
print to_json({quotes = quotes, unknown = unknown})
