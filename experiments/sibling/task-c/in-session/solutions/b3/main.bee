use py:json as json
use py:libs.weeks.dates as dates
use go:"./libs/leadtime" as lt
use js:"fastest-levenshtein" as words
use rust:"./libs/stats" as stats
use cs:"./libs/Packaging" as pk

record Item { sku: Text, supplier: Text, stock: Int, pack: Int, price: Float }
record Sale { sku: Text, date: Text, qty: Int }
record Input { today: Text, items: List[Item], sales: List[Sale] }
record Line { qty: Int, arrive: Text }

foreign json.loads(Text) -> Input
foreign dates.add_days(Text, Int) -> Text
foreign dates.iso_week(Text) -> Int
foreign dates.to_weekday(Text) -> Text
foreign lt.Days(Text) -> Option[Int] on error
foreign lt.Suppliers() -> List[Text]
foreign words.distance(Text, Text) -> Int
foreign stats.trailing_mean(List[Float], Int) -> Float
foreign stats.percentile(List[Float], Float) -> Float
foreign pk.Packs.RoundUp(Int, Int) -> Int

let data = json.loads(read_line())

fn canon(name: Text) -> Text =
    let names = sorted(lt.Suppliers())
    let best = min([words.distance(name, s) for s in names]) ?? 99
    let winners = [s for s in names where words.distance(name, s) == best]
    if best <= 2 then (winners[0] ?? name) else name

fn lead(item: Item) -> Option[Int] = lt.Days(canon(item.supplier))
let days = [dates.add_days(data.today, i - 28) for i in range(28)]
let week = dates.iso_week(data.today)
let peak = week >= 48 and week <= 52

fn series(sku: Text) -> List[Float] =
    [sum([s.qty for s in data.sales where s.sku == sku and s.date == d]) * 1.0 for d in days]

fn plan(item: Item) -> Line =
    let ld = lead(item) ?? 0
    let s = series(item.sku)
    let fc = stats.trailing_mean(s, 7) * (if peak then 1.25 else 1.0)
    let need = fc * ((ld + 7) * 1.0) + stats.percentile(s, 90.0) - item.stock * 1.0
    let q = pk.Packs.RoundUp(ceil(need), item.pack)
    if q * item.price >= 500.0
    then Line { qty = q, arrive = dates.to_weekday(dates.add_days(data.today, ld)) }
    else Line { qty = 0, arrive = "" }

let known = [i for i in data.items where lead(i) != none]
let orders = {i.sku: plan(i) for i in known where plan(i).qty > 0}
let unknown = sorted([i.sku for i in data.items where lead(i) == none])
print to_json({orders = orders, unknown = unknown})
