use py:json as json
use py:builtins as bi
use py:re as re
use py:math as math
use js:semver as versions

record Release { package: Text, version: Text, date: Text }
record Input { releases: List[Release], today: Text, stale_days: Int, watch: Option[Dict[Text, Text]] }
record Latest { version: Text, date: Text }

foreign json.loads(Text) -> Input
foreign bi.int(Text) -> Int
foreign re.findall(Text, Text) -> List[Text]
foreign math.floor(Float) -> Int

let data = json.loads(read_line())
let stable = [r for r in data.releases where versions.prerelease(r.version) == none]

fn is_latest(r: Release) -> Bool =
    len([s for s in stable where s.package == r.package and versions.gt(s.version, r.version)]) == 0

let tops = [r for r in stable where is_latest(r)]

fn days(y: Int, m: Int, d: Int) -> Int =
    let yy = if m <= 2 then y - 1 else y
    let era = math.floor(yy / 400)
    let yoe = yy - era * 400
    let mp = if m > 2 then m - 3 else m + 9
    let doy = math.floor((153 * mp + 2) / 5) + d - 1
    let doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
    era * 146097 + doe - 719468

fn ymd(date: Text, k: Int) -> Int =
    bi.int((re.findall("[0-9]+", date))[k] ?? "0")

fn day_no(date: Text) -> Int = days(ymd(date, 0), ymd(date, 1), ymd(date, 2))

fn week_key(date: Text) -> Text =
    let y = ymd(date, 0)
    let m = ymd(date, 1)
    let d = ymd(date, 2)
    let n = days(y, m, d)
    let iso_wd = (n + 3) % 7 + 1
    let thu = n - iso_wd + 4
    let yw = if thu < days(y, 1, 1) then y - 1 else if thu >= days(y + 1, 1, 1) then y + 1 else y
    let w = math.floor((thu - days(yw, 1, 1)) / 7) + 1
    text(yw) + "-W" + (if w < 10 then "0" else "") + text(w)

let week_keys = [week_key(r.date) for r in data.releases]
let weekly = {k: len([j for j in week_keys where j == k]) for k in week_keys}

let latest = {r.package: {version = r.version, date = r.date} for r in tops}
let today_no = day_no(data.today)
let stale = sorted(keys({r.package: 0 for r in tops where today_no - day_no(r.date) > data.stale_days}))

let watch: Dict[Text, Text] = data.watch ?? {"": ""}
let watch_names = keys(watch)
fn best(w: Text) -> Option[Text] =
    let vs: List[Text] = [r.version for r in data.releases where r.package == w]
    let range: Text = watch[w] ?? ""
    versions.maxSatisfying(vs, range)

let picked = {w: best(w) for w in watch_names}
let watched = {w: picked[w] ?? "" for w in watch_names where (picked[w] ?? "") != ""}

let majors = {p: len(keys({text(versions.major(s.version)): 0 for s in stable where s.package == p})) for p in keys(latest)}

print to_json({latest = latest, weekly = weekly, stale = stale, watched = watched, majors = majors})
