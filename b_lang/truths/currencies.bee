domain currency: "SEK", "NOK", "DKK", "ISK", "EUR", "USD", "GBP", "CHF", "JPY", "CNY", "INR", "CAD", "AUD", "NZD", "PLN", "CZK", "HUF", "BRL", "MXN", "ZAR", "KRW", "SGD", "HKD", "TRY"
fn currency_name(code: Text) -> Text pure = if code == "SEK" then "Swedish krona" else if code == "NOK" then "Norwegian krone" else if code == "DKK" then "Danish krone" else if code == "ISK" then "Icelandic króna" else if code == "EUR" then "euro" else if code == "USD" then "United States dollar" else if code == "GBP" then "pound sterling" else if code == "CHF" then "Swiss franc" else if code == "JPY" then "Japanese yen" else if code == "CNY" then "Chinese yuan" else if code == "INR" then "Indian rupee" else if code == "CAD" then "Canadian dollar" else if code == "AUD" then "Australian dollar" else if code == "NZD" then "New Zealand dollar" else if code == "PLN" then "Polish złoty" else if code == "CZK" then "Czech koruna" else if code == "HUF" then "Hungarian forint" else if code == "BRL" then "Brazilian real" else if code == "MXN" then "Mexican peso" else if code == "ZAR" then "South African rand" else if code == "KRW" then "South Korean won" else if code == "SGD" then "Singapore dollar" else if code == "HKD" then "Hong Kong dollar" else if code == "TRY" then "Turkish lira" else "unknown"
group nordic of currency: "SEK", "NOK", "DKK", "ISK"
example currency_name("SEK") == "Swedish krona"
example currency_name("USD") == "United States dollar"
