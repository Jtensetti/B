domain day: "mon", "tue", "wed", "thu", "fri", "sat", "sun"
group weekend of day: "sat", "sun"
group weekday of day: "mon", "tue", "wed", "thu", "fri"
domain month: "jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"
group q1 of month: "jan", "feb", "mar"
group q2 of month: "apr", "may", "jun"
group q3 of month: "jul", "aug", "sep"
group q4 of month: "oct", "nov", "dec"
group summer of month: "jun", "jul", "aug"
group winter of month: "dec", "jan", "feb"
