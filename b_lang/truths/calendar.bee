domain day: "mon", "tue", "wed", "thu", "fri", "sat", "sun"
group weekend of day: "sat", "sun"
group weekday of day: "mon", "tue", "wed", "thu", "fri"
domain month: "jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"
group q1 of month: "jan", "feb", "mar"
group q2 of month: "apr", "may", "jun"
group q3 of month: "jul", "aug", "sep"
group q4 of month: "oct", "nov", "dec"
group summer of month: "jun", "jul", "aug"
group winter of month: "dec", "jan", "feb"

fn next_day(day: Text) -> Text pure = if day == "mon" then "tue" else if day == "tue" then "wed" else if day == "wed" then "thu" else if day == "thu" then "fri" else if day == "fri" then "sat" else if day == "sat" then "sun" else "mon"
fn previous_day(day: Text) -> Text pure = if day == "mon" then "sun" else if day == "tue" then "mon" else if day == "wed" then "tue" else if day == "thu" then "wed" else if day == "fri" then "thu" else if day == "sat" then "fri" else "sat"
fn leap_year(year: Int) -> Bool pure = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
fn days_in_month(month: Text, year: Int) -> Int pure = if month == "feb" then (if leap_year(year) then 29 else 28) else if month == "apr" or month == "jun" or month == "sep" or month == "nov" then 30 else 31
fn days_in_year(year: Int) -> Int pure = if leap_year(year) then 366 else 365
example next_day("sun") == "mon"
example previous_day("mon") == "sun"
example leap_year(2024) == true
example leap_year(1900) == false
example leap_year(2000) == true
example days_in_month("feb", 2023) == 28
example days_in_month("feb", 2024) == 29
example days_in_month("sep", 2024) == 30
example days_in_year(2100) == 365
