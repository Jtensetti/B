start: (_NL | stmt _NL)* stmt?
_NL: NEWLINE

?stmt: "permit" "[" [names] "]"                          -> permit_stmt
     | "use" "js" ":" ESCAPED_STRING "as" NAME            -> js_string_use
     | "use" "js" ":" path "as" NAME                     -> js_use
     | "use" BACKEND ":" path "as" NAME                   -> use_stmt
     | "adopt" "py" ":" path "as" NAME                  -> adopt_stmt
     | "let" NAME [":" type_expr] "=" expr               -> let_stmt
     | "fn" NAME "(" [params] ")" "->" type_expr fn_pure? fn_requires? fn_ensures? "=" expr -> fn_stmt
     | "next" NAME "when" expr "=>" expr                   -> next_stmt
     | "print" expr                                       -> print_stmt
     | "assert" expr                                      -> assert_stmt
     | "foreign" path "(" [type_list] ")" "->" type_expr -> foreign_stmt

fn_pure: "pure"
fn_requires: "requires" expr
fn_ensures: "ensures" expr
names: NAME ("," NAME)*

path: NAME ("." NAME)*
type_list: type_expr ("," type_expr)*
params: param ("," param)*
param: NAME ":" type_expr
type_expr: NAME ["[" type_expr ("," type_expr)* "]"]

?expr: "if" expr "then" expr "else" expr -> conditional
     | coalesce_expr
?coalesce_expr: or_expr "??" coalesce_expr -> coalesce
              | or_expr
?or_expr: or_expr "or" and_expr     -> or_op
        | and_expr
?and_expr: and_expr "and" cmp_expr -> and_op
         | cmp_expr
?cmp_expr: cmp_expr COMP sum_expr  -> comparison
         | sum_expr
?sum_expr: sum_expr "+" mul_expr  -> add
         | sum_expr "-" mul_expr   -> subtract
         | mul_expr
?mul_expr: mul_expr "*" unary_expr -> multiply
         | mul_expr "/" unary_expr -> divide
         | mul_expr "%" unary_expr -> modulo
         | unary_expr
?unary_expr: "not" unary_expr     -> not_op
           | "-" unary_expr       -> neg
           | postfix
?postfix: atom tail*                -> postfix
?tail: "." NAME                    -> attribute
     | "(" [args] ")"              -> invoke
args: expr ("," expr)*
pairs: pair ("," pair)*
pair: expr ":" expr
?scalar: number_literal
       | ESCAPED_STRING              -> string
       | "true"                      -> true
       | "false"                     -> false
       | "none"                      -> none
number_literal: NUMBER               -> number
?case_literal: scalar
             | "-" number_literal    -> neg
case_row: COMP case_literal "=>" expr
_ROW_SEMI: ";"
_row_sep: _ROW_SEMI _NL* | _NL+
case_table: CASES NAME "{" _NL* (case_row _row_sep)+ "else" "=>" expr _ROW_SEMI? _NL* "}"

?atom: case_table
     | CASES                         -> identifier
     | scalar
     | NAME                          -> identifier
     | "[" [args] "]"                -> list_literal
     | "{" [pairs] "}"               -> dict_literal
     | "(" expr ")"                  -> grouped

// At expression position CASES may also be an ordinary name or call.
CASES: "cases"
BACKEND: "py" | "net"
COMP: "==" | "!=" | "<=" | ">=" | "<" | ">"
NAME: /[A-Za-z_][A-Za-z0-9_]*/
NUMBER: /(?:0|[1-9][0-9]*)(?:\.[0-9]+)?/
%import common.ESCAPED_STRING
%import common.NEWLINE
%import common.WS_INLINE
%ignore WS_INLINE
